<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="lambda-iot" name="Вариант 2 — Lambda">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2480" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Практическая №2, вариант 2 — поток IoT-событий без потерь и задвоений. Lambda-архитектура" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Почему Lambda, а не Kappa&lt;/b&gt;&lt;br&gt;Нужны и точные суточные отчёты, и живой мониторинг. Speed-слой отвечает быстро, но ждёт опоздавших только 2 минуты. Batch-слой раз в сутки пересчитывает отчёт из bronze, где лежит всё, включая события, опоздавшие на часы. Оба слоя — один движок (Spark) и общий код разбора события." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=12;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="550" height="125" as="geometry" />
        </mxCell>

        <!-- ===== источник и транспорт ===== -->
        <mxCell id="src" value="&lt;b&gt;IoT-датчики&lt;/b&gt;&lt;br&gt;generator.py (Python)&lt;br&gt;20 датчиков, ~20 событий/с&lt;br&gt;дубли 5%, опоздания 15%,&lt;br&gt;очень поздние 2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="kafka" value="&lt;b&gt;Apache Kafka&lt;/b&gt; (KRaft)&lt;br&gt;топик iot.events, 3 партиции&lt;br&gt;ключ = sensor_id&lt;br&gt;retention 7 дней" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="220" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ckpt" value="&lt;b&gt;Checkpoint&lt;/b&gt; (том Docker)&lt;br&gt;offsets Kafka, состояние&lt;br&gt;окон и дедупликации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="430" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Spark Structured Streaming ===== -->
        <mxCell id="stream" value="Spark Structured Streaming — один процесс, два запроса" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="320" height="420" as="geometry" />
        </mxCell>
        <mxCell id="speed" value="&lt;b&gt;Запрос speed&lt;/b&gt;&lt;br&gt;event-time + watermark 2 мин&lt;br&gt;dropDuplicatesWithinWatermark(event_id)&lt;br&gt;окна по 1 мин на датчик" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="stream">
          <mxGeometry x="20" y="50" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="bronzeq" value="&lt;b&gt;Запрос bronze&lt;/b&gt;&lt;br&gt;сообщения без изменений&lt;br&gt;+ partition / offset / время Kafka&lt;br&gt;микробатч 30 с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="stream">
          <mxGeometry x="20" y="260" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- ===== Spark batch ===== -->
        <mxCell id="batch" value="&lt;b&gt;Spark batch&lt;/b&gt; (batch_job.py)&lt;br&gt;запуск раз в сутки&lt;br&gt;(на стенде — вручную)&lt;br&gt;&lt;br&gt;1) разбор JSON, дедуп по event_id&lt;br&gt;2) пересчёт только затронутых дат&lt;br&gt;3) сверка с эталоном генератора&lt;br&gt;&lt;br&gt;повторный запуск ничего не меняет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="280" height="250" as="geometry" />
        </mxCell>

        <!-- ===== Lakehouse ===== -->
        <mxCell id="lake" value="Lakehouse: Apache Iceberg на MinIO (S3)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1360" y="280" width="280" height="520" as="geometry" />
        </mxCell>
        <mxCell id="bronze" value="&lt;b&gt;bronze.events&lt;/b&gt;&lt;br&gt;сырые JSON, append-only&lt;br&gt;дубли и поздние — все здесь" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lake">
          <mxGeometry x="30" y="50" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="silver" value="&lt;b&gt;silver.events&lt;/b&gt;&lt;br&gt;уникальные события&lt;br&gt;партиции по event_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lake">
          <mxGeometry x="30" y="240" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gold" value="&lt;b&gt;gold.daily_report&lt;/b&gt;&lt;br&gt;агрегаты: сутки × датчик" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lake">
          <mxGeometry x="30" y="390" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="&lt;b&gt;Каталог Iceberg&lt;/b&gt;&lt;br&gt;JDBC, PostgreSQL&lt;br&gt;(БД iceberg_catalog)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1820" y="340" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Serving ===== -->
        <mxCell id="pglive" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;live_sensor_1m (speed view)&lt;br&gt;PK (window_start, sensor_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1820" y="120" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pgdaily" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;daily_report (batch view)&lt;br&gt;PK (event_date, sensor_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1820" y="665" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Потребители ===== -->
        <mxCell id="grafana" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;живой мониторинг&lt;br&gt;автообновление 5 с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2210" y="120" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="reports" value="&lt;b&gt;Grafana / BI&lt;/b&gt;&lt;br&gt;точные суточные отчёты&lt;br&gt;и сверка с эталоном" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2210" y="665" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- ===== подписи слоёв ===== -->
        <mxCell id="lblspeed" value="SPEED LAYER — свежесть: задержка около 10 секунд" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1190" y="100" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lblbatch" value="BATCH LAYER — точность: все события, включая поздние" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="780" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lblserving" value="SERVING LAYER" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1820" y="80" width="220" height="30" as="geometry" />
        </mxCell>

        <!-- ===== стрелки: поток (сплошные) ===== -->
        <mxCell id="e1" value="1. JSON-события&lt;br&gt;acks=all, idempotence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="src" target="kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. поток событий&lt;br&gt;(readStream)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kafka" target="speed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="256" />
              <mxPoint x="680" y="175" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="3. upsert минутных агрегатов (foreachBatch, режим update)&lt;br&gt;повтор микробатча не задваивает строки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="speed" target="pglive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. SQL-запрос&lt;br&gt;каждые 5 с" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="pglive" target="grafana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. те же сообщения&lt;br&gt;для batch-слоя" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kafka" target="bronzeq">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="304" />
              <mxPoint x="680" y="385" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="6. append каждые 30 с,&lt;br&gt;микробатч коммитится один раз" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.225;entryDx=0;entryDy=0;" edge="1" parent="1" source="bronzeq" target="bronze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eck" value="offsets и state:&lt;br&gt;запись / восстановление" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=1.5;exitX=0;exitY=0.95;exitDx=0;exitDy=0;entryX=1;entryY=0.36;entryDx=0;entryDy=0;" edge="1" parent="1" source="stream" target="ckpt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== стрелки: batch (пунктир) ===== -->
        <mxCell id="e7" value="7. сырые сообщения&lt;br&gt;за последние 2 дня" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="bronze" target="batch">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1180" y="410" />
              <mxPoint x="1180" y="540" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="8. MERGE по event_id&lt;br&gt;(только новые события)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="batch" target="silver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="9. MERGE агрегатов из silver&lt;br&gt;за затронутые даты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="batch" target="gold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="10. выгрузка витрины&lt;br&gt;(upsert по PK)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gold" target="pgdaily">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="11. SQL-запросы&lt;br&gt;отчётов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="pgdaily" target="reports">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ecat" value="atomic commit:&lt;br&gt;текущий metadata.json" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=1.5;exitX=1;exitY=0.2019;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lake" target="catalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

