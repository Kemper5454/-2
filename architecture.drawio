          <mxGeometry x="20" y="100" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg3t" value="обработка: Spark (streaming и batch)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="legend">
          <mxGeometry x="75" y="95" width="450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend">
